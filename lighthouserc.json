{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "node scripts/lighthouse/server.mjs",
      "startServerReadyPattern": "stub ready",
      "url": [
        "http://localhost:4517/ChosenPicachu/",
        "http://localhost:4517/ChosenPicachu/gallery/?tab=vam",
        "http://localhost:4517/ChosenPicachu/users/",
        "http://localhost:4517/ChosenPicachu/demos/",
        "http://localhost:4517/ChosenPicachu/games/",
        "http://localhost:4517/ChosenPicachu/demos/?tab=tables",
        "http://localhost:4517/ChosenPicachu/demos/?tab=tables&world=vanilla",
        "http://localhost:4517/ChosenPicachu/demos/?tab=tables&tut=menu",
        "http://localhost:4517/ChosenPicachu/demos/?tab=tables&tut=resize",
        "http://localhost:4517/ChosenPicachu/demos/?tab=dragAndDrop"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/gallery/.*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.92
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^((?!/gallery/).)*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.92
              }
            ]
          }
        }
      ]
    }
  }
}
