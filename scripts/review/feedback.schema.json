{
  "type": "object",
  "additionalProperties": false,
  "required": ["overview", "nextSteps", "habits", "plusses", "deltas"],
  "$defs": {
    "door": {"type": "string", "enum": ["structure", "presentation", "dynamic interaction", "design", "tests", "tutorials"]},
    "severity": {"type": "string", "enum": ["violation", "concern", "note"]},
    "evidence": {"type": "string", "enum": ["read", "inferred"]}
  },
  "properties": {
    "overview": {"type": "string"},
    "nextSteps": {"type": "array", "items": {"type": "string"}},
    "habits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "rule", "problem", "why", "fix"],
        "properties": {
          "title": {"type": "string"},
          "rule": {"type": "string"},
          "problem": {"type": "string"},
          "why": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    },
    "deferred": {"type": "string"},
    "plusses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["door", "habit", "file", "line", "happened", "why", "evidence", "principle"],
        "properties": {
          "door": {"$ref": "#/$defs/door"},
          "habit": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "happened": {"type": "string"},
          "why": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "checked": {"type": "string"},
          "principle": {"type": "string"}
        }
      }
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["door", "habit", "severity", "file", "line", "happened", "why", "evidence", "change", "principle"],
        "properties": {
          "door": {"$ref": "#/$defs/door"},
          "habit": {"type": "string"},
          "severity": {"$ref": "#/$defs/severity"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "happened": {"type": "string"},
          "why": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "change": {"type": "string"},
          "checked": {"type": "string"},
          "principle": {"type": "string"}
        }
      }
    }
  }
}
