{
  "type": "object",
  "additionalProperties": false,
  "required": ["tldr", "plusses", "deltas"],
  "$defs": {
    "door": {"type": "string", "enum": ["structure", "presentation", "dynamic interaction", "design", "tests"]},
    "severity": {"type": "string", "enum": ["violation", "concern", "note"]},
    "evidence": {"type": "string", "enum": ["read", "inferred"]}
  },
  "properties": {
    "tldr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranked", "held"],
      "properties": {
        "ranked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line", "cost", "change"],
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "cost": {"type": "string"},
              "change": {"type": "string"}
            }
          }
        },
        "held": {"type": "string"},
        "deferred": {"type": "string"}
      }
    },
    "plusses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["door", "file", "line", "happened", "why", "evidence", "principle"],
        "properties": {
          "door": {"$ref": "#/$defs/door"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "happened": {"type": "string"},
          "why": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "checked": {"type": "string"},
          "principle": {"type": "string"}
        }
      }
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["door", "severity", "file", "line", "happened", "why", "evidence", "change", "principle"],
        "properties": {
          "door": {"$ref": "#/$defs/door"},
          "severity": {"$ref": "#/$defs/severity"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "happened": {"type": "string"},
          "why": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "change": {"type": "string"},
          "checked": {"type": "string"},
          "principle": {"type": "string"}
        }
      }
    }
  }
}
