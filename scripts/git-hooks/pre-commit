#!/bin/bash
# Fast commit-time loop: lint, types, unit tests. The pre-push hook is
# the full gate; this one exists to fail in seconds, not minutes.
# Activate per-clone: git config core.hooksPath scripts/git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: oxlint + stylelint + eslint stylistic..."
npm run lint
npm run lint:css
npm run lint:style

# on a verify/<issue> branch the linters are the whole hook: they take seconds and catch what is in the file now,
# and the branch's push runs the types and the tests in CI (AGENTS.md, "Commits and pushes")
if [[ "$(git branch --show-current)" == verify/* ]]; then
  echo "pre-commit: verify branch, CI runs the types and the tests."
  exit 0
fi

echo "pre-commit: tsc + vitest..."
npx tsc -b
npx vitest run --reporter=dot
echo "pre-commit: clean."
