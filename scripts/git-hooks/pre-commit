#!/bin/bash
# Fast commit-time loop: lint, types, unit tests. The pre-push hook is
# the full gate; this one exists to fail in seconds, not minutes.
# Activate per-clone: git config core.hooksPath scripts/git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# a commit on a verify/<issue> branch runs nothing here: the branch's push runs the gates in CI
# (AGENTS.md, "Commits and pushes"); a commit on main still runs them all
if [[ "$(git branch --show-current)" == verify/* ]]; then
  echo "pre-commit: verify branch, CI runs the gates."
  exit 0
fi

echo "pre-commit: oxlint + stylelint + eslint stylistic + tsc + vitest..."
npm run lint
npm run lint:css
npm run lint:style
npx tsc -b
npx vitest run --reporter=dot
echo "pre-commit: clean."
