#!/bin/bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: oxlint + stylelint + tsc + vitest + build..."
npm run lint
npm run lint:css
npx tsc -b
npx vitest run --reporter=dot
npm run build

echo "pre-push: the journeys, on the stub stage..."
npx playwright test --reporter=line
echo "pre-push: clean."
