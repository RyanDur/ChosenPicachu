#!/bin/bash
# Activate per-clone: git config core.hooksPath scripts/git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: is the pull request's run done, and does any other open pull request change these files?"
read -r _ pushed remote_ref _ || true
if [ -n "${remote_ref:-}" ] && [ "$pushed" != 0000000000000000000000000000000000000000 ]; then
  node scripts/clear-to-push.mjs "${remote_ref#refs/heads/}" "$pushed"
fi

echo "pre-push: oxlint + stylelint + eslint stylistic..."
npm run lint
npm run lint:css
npm run lint:style
echo "pre-push: clean. The pull request's checks run the rest."
