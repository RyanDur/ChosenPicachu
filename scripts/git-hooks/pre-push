#!/bin/bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# a push that only goes to verify/<issue> branches runs nothing here: CI runs the unit tests, journeys and review
# for it, so a dev never waits for the machine or for the other dev's journeys (AGENTS.md, "Commits and pushes")
only_verify=true
while read -r _ _ remote_ref _; do
  [[ "$remote_ref" == refs/heads/verify/* ]] || only_verify=false
done
if [[ "$only_verify" == true ]]; then
  echo "pre-push: verify branch, CI runs the gates."
  exit 0
fi

echo "pre-push: oxlint + stylelint + tsc + vitest + build..."
npm run lint
npm run lint:css
npx tsc -b
npx vitest run --reporter=dot
npm run build

# one engine at a time, as CI runs them: a local WebKit worker stalls on its 90th browser context
for engine in chromium firefox webkit; do
  echo "pre-push: the journeys in ${engine}, on the stub stage..."
  npx playwright test --project="${engine}*" --reporter=line
done
echo "pre-push: clean."
