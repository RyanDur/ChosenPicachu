{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.cjs", "playwright.smoke.config.cjs", "playwright.looks.config.cjs", "playwright.media.config.cjs", "vite.config.cjs",
    "src/components/Users/resource/usersServer.ts", "src/pages/Practice/practiceDrawings.ts"]
}
