{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts", "playwright.smoke.config.ts", "vite.config.ts",
    "src/components/Users/resource/usersServer.ts"]
}
