{
  "name": "chosen-picachu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "tsc -b && vite build && vite build --ssr src/entry.server.tsx --outDir build/server && node scripts/prerender.mjs",
    "lint": "oxlint --type-aware --deny-warnings",
    "preview": "vite preview",
    "tsc": "tsc -b",
    "lint:css": "stylelint --max-warnings 0 'src/**/*.css'",
    "lint:style": "eslint .",
    "format": "eslint . --fix",
    "lighthouse:record": "node scripts/lighthouse/record.mjs",
    "media": "playwright test --config=playwright.media.config.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@ryandur/sand": "^10.0.0",
    "date-fns": "4.1.0",
    "isbot": "5.2.2",
    "random-avatar-generator": "^2.0.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-router": "7.18.4",
    "schemawax": "^1.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.10",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@faker-js/faker": "10.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "7.18.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "dom-accessibility-api": "0.5.16",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "html-validate": "^11.17.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "patch-package": "^8.0.1",
    "rolldown": "^1.2.16",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12",
    "vitest-location-mock": "^1.0.4",
    "ws": "^8.22.1"
  },
  "overrides": {
    "@react-router/dev": {
      "typescript": "$typescript"
    },
    "@react-router/node": {
      "typescript": "$typescript"
    },
    "react-server-dom-webpack": "19.2.7"
  }
}
